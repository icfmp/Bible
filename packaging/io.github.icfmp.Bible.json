{
  "app-id": "io.github.icfmp.Bible",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "bible",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "swig",
      "buildsystem": "autotools",
      "config-opts": [
        "--without-pcre",
        "--disable-ccache"
      ],
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://deb.debian.org/debian/pool/main/s/swig/swig_4.3.0.orig.tar.gz",
          "sha256": "f7203ef796f61af986c70c05816236cbd0d31b7aa9631e5ab53020ab7804aa9e"
        }
      ]
    },
    {
      "name": "sword",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_CXX_STANDARD=17",
        "-DSWORD_BUILD_UTILS=No",
        "-DSWORD_BUILD_TESTS=OFF",
        "-DSWORD_NO_CURL=Yes",
        "-DSWORD_SWIG_BINDINGS=OFF",
        "-DLIBSWORD_LIBRARY_TYPE=Shared"
      ],
      "post-install": [
        "mkdir -p /app/lib/bible-python",
        "swig -w451,402 -shadow -c++ -python -I../bindings/swig -I../include -outdir /app/lib/bible-python -o Sword.cxx ../bindings/swig/sword.i",
        "c++ -std=c++17 -shared -fPIC -O2 $(python3-config --includes) -I../include -I../bindings/swig Sword.cxx -L/app/lib -lsword -o /app/lib/bible-python/_Sword.so",
        "PYTHONPATH=/app/lib/bible-python python3 -c 'import Sword; assert Sword.VerseKey(\"Gen.1.1\").getOSISRef() == \"Gen.1.1\"'"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://deb.debian.org/debian/pool/main/s/sword/sword_1.9.0+dfsg.orig.tar.xz",
          "sha256": "a1687b8ade230d9b30a9991b76c12920daac865f1c25bd4be3cb897b90f007d9"
        }
      ],
      "builddir": true
    },
    {
      "name": "bible",
      "buildsystem": "simple",
      "build-commands": [
        "cp -r bible /app/lib/bible-python/",
        "install -Dm755 packaging/bible /app/bin/bible",
        "install -Dm644 packaging/io.github.icfmp.Bible.desktop /app/share/applications/io.github.icfmp.Bible.desktop"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            ".flatpak-builder",
            "build-dir"
          ]
        }
      ]
    }
  ]
}
