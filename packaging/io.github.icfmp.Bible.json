{
  "app-id": "io.github.icfmp.Bible",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "bible",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "swig",
      "buildsystem": "autotools",
      "config-opts": [
        "--without-pcre",
        "--disable-ccache"
      ],
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://deb.debian.org/debian/pool/main/s/swig/swig_4.3.0.orig.tar.gz",
          "sha256": "f7203ef796f61af986c70c05816236cbd0d31b7aa9631e5ab53020ab7804aa9e"
        }
      ]
    },
    {
      "name": "sword",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_CXX_STANDARD=17",
        "-DSWORD_BUILD_UTILS=Yes",
        "-DSWORD_BUILD_TESTS=OFF",
        "-DSWORD_NO_CURL=Yes",
        "-DSWORD_SWIG_BINDINGS=OFF",
        "-DLIBSWORD_LIBRARY_TYPE=Shared"
      ],
      "post-install": [
        "mkdir -p /app/lib/bible-python",
        "swig -w451,402 -shadow -c++ -python -I../bindings/swig -I../include -outdir /app/lib/bible-python -o Sword.cxx ../bindings/swig/sword.i",
        "c++ -std=c++17 -shared -fPIC -O2 $(python3-config --includes) -I../include -I../bindings/swig Sword.cxx -L/app/lib -lsword -o /app/lib/bible-python/_Sword.so",
        "PYTHONPATH=/app/lib/bible-python python3 -c 'import Sword; assert Sword.VerseKey(\"Gen.1.1\").getOSISRef() == \"Gen.1.1\"'",
        "install -Dm644 ../LICENSE /app/share/licenses/sword/LICENSE"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://deb.debian.org/debian/pool/main/s/sword/sword_1.9.0+dfsg.orig.tar.xz",
          "sha256": "a1687b8ade230d9b30a9991b76c12920daac865f1c25bd4be3cb897b90f007d9"
        },
        {
          "type": "patch",
          "path": "sword-system-zlib.patch"
        },
        {
          "type": "patch",
          "path": "sword-osis-fidelity.patch"
        }
      ],
      "builddir": true
    },
    {
      "name": "babel",
      "buildsystem": "simple",
      "build-commands": [
        "python3 -c \"import zipfile; zipfile.ZipFile('Babel.whl').extractall('/app/lib/bible-python')\"",
        "install -Dm644 /app/lib/bible-python/babel-2.18.0.dist-info/licenses/LICENSE /app/share/licenses/babel/LICENSE",
        "install -Dm644 /app/lib/bible-python/babel/locale-data/LICENSE.unicode /app/share/licenses/babel/LICENSE.unicode"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/77/f5/21d2de20e8b8b0408f0681956ca2c69f1320a3848ac50e6e7f39c6159675/babel-2.18.0-py3-none-any.whl",
          "sha256": "e2b422b277c2b9a9630c1d7903c2a00d0830c409c59ac8cae9081c92f1aeba35",
          "dest-filename": "Babel.whl"
        }
      ]
    },
    {
      "name": "iso-codes",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 data/iso_639-3.json /app/share/iso-codes/json/iso_639-3.json",
        "msgfmt -o iso_639-3.mo iso_639-3/fr.po",
        "install -Dm644 iso_639-3.mo /app/share/locale/fr/LC_MESSAGES/iso_639-3.mo",
        "install -Dm644 COPYING /app/share/licenses/iso-codes/COPYING"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://deb.debian.org/debian/pool/main/i/iso-codes/iso-codes_4.18.0.orig.tar.xz",
          "sha256": "066bc4df7bf299561856a07119cde01d563c8c4c39906537a39363bb833d466c"
        }
      ]
    },
    {
      "name": "reader-fonts",
      "buildsystem": "simple",
      "build-commands": [
        "ar p fonts-dejavu-core.deb data.tar.xz | tar -xJ",
        "ar p fonts-dejavu-extra.deb data.tar.xz | tar -xJ",
        "install -d /app/share/fonts/dejavu",
        "for font in DejaVuSerif.ttf DejaVuSerif-Bold.ttf DejaVuSerif-Italic.ttf DejaVuSerif-BoldItalic.ttf DejaVuSans.ttf DejaVuSans-Bold.ttf DejaVuSans-Oblique.ttf DejaVuSans-BoldOblique.ttf; do install -m644 usr/share/fonts/truetype/dejavu/$font /app/share/fonts/dejavu/; done",
        "install -Dm644 usr/share/doc/fonts-dejavu-core/copyright /app/share/licenses/dejavu/copyright",
        "install -Dm644 usr/share/doc/fonts-dejavu-extra/copyright /app/share/licenses/dejavu/extra-copyright"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://deb.debian.org/debian/pool/main/f/fonts-dejavu/fonts-dejavu-core_2.37-8_all.deb",
          "sha256": "86635b3d25b3655fc11cb3ecc3af59f0bf19643b02b94f2de48bd10253cdba12",
          "dest-filename": "fonts-dejavu-core.deb"
        },
        {
          "type": "file",
          "url": "https://deb.debian.org/debian/pool/main/f/fonts-dejavu/fonts-dejavu-extra_2.37-8_all.deb",
          "sha256": "83128d00e5d7db412fe5a7a4e2ee32aebbf8d9ed560ad611202fb43078f80323",
          "dest-filename": "fonts-dejavu-extra.deb"
        }
      ]
    },
    {
      "name": "bible",
      "buildsystem": "simple",
      "build-commands": [
        "cp -r bible /app/lib/bible-python/",
        "install -Dm755 packaging/bible /app/bin/bible",
        "install -Dm644 packaging/io.github.icfmp.Bible.desktop /app/share/applications/io.github.icfmp.Bible.desktop",
        "for size in 32 48 64 128 256 512; do install -Dm644 packaging/icons/${size}x${size}/io.github.icfmp.Bible.png /app/share/icons/hicolor/${size}x${size}/apps/io.github.icfmp.Bible.png; done",
        "install -Dm644 LICENSE /app/share/licenses/bible/LICENSE",
        "install -Dm644 THIRD_PARTY_NOTICES.md /app/share/licenses/bible/THIRD_PARTY_NOTICES.md",
        "install -Dm644 third_party/jsword/COPYING.LESSER /app/share/licenses/jsword/COPYING.LESSER",
        "install -Dm644 third_party/jsword/provenance.json /app/share/licenses/jsword/provenance.json",
        "install -Dm644 packaging/icons/scalable/apps/io.github.icfmp.Bible.svg /app/share/icons/hicolor/scalable/apps/io.github.icfmp.Bible.svg",
        "install -Dm644 packaging/icons/scalable/apps/io.github.icfmp.Bible.Devel.svg /app/share/icons/hicolor/scalable/apps/io.github.icfmp.Bible.Devel.svg",
        "install -Dm644 packaging/icons/symbolic/apps/io.github.icfmp.Bible-symbolic.svg /app/share/icons/hicolor/symbolic/apps/io.github.icfmp.Bible-symbolic.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            ".flatpak-builder",
            "build-dir"
          ]
        }
      ]
    }
  ]
}
