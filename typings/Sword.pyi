"""Consumed SWORD 1.9 SWIG API, checked against packaged headers and bindings.

This describes the existing native dependency, not a replacement implementation.
C++ char results are one-character Python strings in the packaged SWIG binding;
integer constants and setters retain their native numeric input convention.
"""

from typing import Self, overload

DIRECTION_LTR: int
DIRECTION_RTL: int
ENC_UTF8: int
FMT_PLAIN: int

class SWKey:
    thisown: bool
    def __init__(self, text: str | SWKey | None = ...) -> None: ...
    def clone(self) -> SWKey: ...
    def popError(self) -> str: ...
    def getError(self) -> str: ...
    def setText(self, text: str) -> None: ...
    def getText(self) -> str: ...
    def getIndex(self) -> int: ...
    def setIndex(self, index: int) -> None: ...
    def increment(self, steps: int = ...) -> None: ...
    def decrement(self, steps: int = ...) -> None: ...
    def positionFrom(self, key: SWKey) -> None: ...
    def setPersist(self, persist: bool) -> None: ...

class VerseKey(SWKey):
    @overload
    def __init__(self, text: str | SWKey | None = ...) -> None: ...
    @overload
    def __init__(self, minimum: str, maximum: str, versification: str = ...) -> None: ...
    def clone(self) -> VerseKey: ...
    def getOSISRef(self) -> str: ...
    def getOSISBookName(self) -> str: ...
    def getBookName(self) -> str: ...
    def getBookAbbrev(self) -> str: ...
    def getTestament(self) -> str: ...
    def getTestamentMax(self) -> int: ...
    def getBook(self) -> str: ...
    def getBookMax(self) -> int: ...
    def getChapter(self) -> int: ...
    def getChapterMax(self) -> int: ...
    def getVerse(self) -> int: ...
    def getVerseMax(self) -> int: ...
    def setTestament(self, testament: int) -> None: ...
    def setBook(self, book: int) -> None: ...
    def setChapter(self, chapter: int) -> None: ...
    def setVerse(self, verse: int) -> None: ...
    def setAutoNormalize(self, normalize: bool) -> None: ...
    def setIntros(self, intros: bool) -> None: ...
    def setVersificationSystem(self, system: str) -> None: ...
    def getVersificationSystem(self) -> str: ...
    def isBoundSet(self) -> bool: ...
    def getUpperBound(self) -> VerseKey: ...
    def getLowerBound(self) -> VerseKey: ...

class SWModule:
    thisown: bool
    def getConfigEntry(self, key: str) -> str | None: ...
    def setKey(self, key: SWKey) -> str: ...
    def getKey(self) -> SWKey: ...
    def getKeyText(self) -> str: ...
    def hasEntry(self, key: SWKey) -> bool: ...
    def isLinked(self, first: SWKey, second: SWKey) -> bool: ...
    def getRawEntry(self) -> str: ...
    def stripText(self) -> str: ...
    def getDirection(self) -> str: ...
    def setEntry(self, text: str, length: int = ...) -> None: ...
    def linkEntry(self, key: SWKey) -> None: ...

class SWMgr:
    def __init__(self, path: str | None = ...) -> None: ...
    def getModule(self, name: str) -> SWModule | None: ...

class SWLD(SWModule):
    @classmethod
    def castTo(cls, module: SWModule) -> Self | None: ...
    def getEntryCount(self) -> int: ...
    def getKeyForEntry(self, index: int) -> str: ...

class TreeKey(SWKey):
    @classmethod
    def castTo(cls, key: SWKey) -> Self | None: ...
    def root(self) -> None: ...
    def parent(self) -> bool: ...
    def firstChild(self) -> bool: ...
    def nextSibling(self) -> bool: ...
    def assureKeyPath(self, path: str | None = ...) -> None: ...
    def save(self) -> None: ...

class SWDisplay:
    """Opaque native display callback handle; Bible passes no custom display."""

class RawText(SWModule):
    def __init__(
        self,
        path: str,
        name: str | None = ...,
        description: str | None = ...,
        display: SWDisplay | None = ...,
        encoding: int = ...,
        direction: int = ...,
        markup: int = ...,
        language: str | None = ...,
        versification: str = ...,
    ) -> None: ...
    @staticmethod
    def createModule(path: str, versification: str = ...) -> str: ...

class RawCom(SWModule):
    def __init__(
        self,
        path: str,
        name: str | None = ...,
        description: str | None = ...,
        display: SWDisplay | None = ...,
        encoding: int = ...,
        direction: int = ...,
        markup: int = ...,
        language: str | None = ...,
        versification: str = ...,
    ) -> None: ...
    @staticmethod
    def createModule(path: str, versification: str = ...) -> str: ...

class ZipCompress:
    thisown: bool
    def __init__(self) -> None: ...
